<Page
    x:Class="App_v1.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App_v1"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:viewModels="using:App_v1.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:DashboardViewModel />
    </Page.DataContext>

    <Grid>
        <Grid
            Margin="16,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>

            <Grid
                Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="Auto" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        ToolTipService.ToolTip="Profile"
                        Background="Transparent"
                        BorderBrush="{x:Null}"
                        Click="ProfileButton_Click">
                        <Button.Flyout>
                            <MenuFlyout
                                Placement="Bottom">
                                <MenuFlyoutItem
                                    Text="Manage Account">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon
                                            Glyph="&#xE77B;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <PersonPicture
                            Width="40"
                            Height="40"
                            ProfilePicture="https://learn.microsoft.com/windows/uwp/contacts-and-calendar/images/shoulder-tap-static-payload.png" />
                    </Button>

                    <StackPanel
                        Orientation="Vertical"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="StaffNameTextBlock"
                            Text="{Binding StaffName, Mode=OneWay}"
                            FontWeight="Bold"
                            FontSize="14" />
                        <TextBlock
                            x:Name="StaffRoleTextBlock"
                            Text="{Binding StaffRole, Mode=OneWay}"
                            FontSize="12"
                            Foreground="Gray" />
                    </StackPanel>
                </StackPanel>

                <Grid
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <AutoSuggestBox
                        Visibility="Collapsed"
                        Width="350"
                        Height="36"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,6"
                        PlaceholderText="Search"
                        TextChanged="Control2_TextChanged"
                        QueryIcon="Find"
                        QuerySubmitted="Control2_QuerySubmitted"
                        SuggestionChosen="Control2_SuggestionChosen">
                        <AutoSuggestBox.Style>
                            <Style
                                TargetType="AutoSuggestBox"
                                BasedOn="{StaticResource DefaultAutoSuggestBoxStyle}">
                                <Setter
                                    Property="CornerRadius"
                                    Value="18" />
                                <Setter
                                    Property="Padding"
                                    Value="12,0" />
                                <Setter
                                    Property="FontSize"
                                    Value="16" />
                            </Style>
                        </AutoSuggestBox.Style>
                    </AutoSuggestBox>
                </Grid>

                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Spacing="8">
                    <Button
                        x:Name="RefreshButton"
                        Click="RefreshButton_Click"
                        ToolTipService.ToolTip="Refresh">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <NavigationView
                Grid.Row="1"
                x:Name="NavView"
                PaneDisplayMode="Left"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                IsTabStop="False"
                IsSettingsVisible="False"
                IsBackButtonVisible="Visible"
                IsBackEnabled="True"
                SelectionChanged="NavView_SelectionChanged"
                BackRequested="NavView_BackRequested">

                <NavigationView.MenuItems>
                    <NavigationViewItem
                        x:Name="HomeNavItem"
                        Content="Home"
                        Icon="Home"
                        Tag="HomePage"
                        Visibility="{Binding HomeNavVisibility, Mode=OneWay}" />
                    <NavigationViewItem
                        x:Name="BranchesNavItem"
                        Content="Branches"
                        Tag="BranchesPage"
                        Visibility="{Binding BranchesNavVisibility, Mode=OneWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                Glyph="&#xECAF;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="CategoriesNavItem"
                        Content="Categories"
                        Icon="Tag"
                        Tag="CategoriesPage"
                        Visibility="{Binding CategoriesNavVisibility, Mode=OneWay}" />
                    <NavigationViewItem
                        x:Name="ProductsNavItem"
                        Content="Products"
                        Icon="Shop"
                        Tag="ProductsPage"
                        Visibility="{Binding ProductsNavVisibility, Mode=OneWay}" />
                    <NavigationViewItem
                        x:Name="OrdersNavItem"
                        Content="Orders"
                        Tag="OrdersPage"
                        Visibility="{Binding OrdersNavVisibility, Mode=OneWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                Glyph="&#xE7BF;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="SuppliersNavItem"
                        Content="Suppliers"
                        Icon="ContactInfo"
                        Tag="SuppliersPage"
                        Visibility="{Binding SuppliersNavVisibility, Mode=OneWay}" />
                    <NavigationViewItem
                        x:Name="StaffNavItem"
                        Content="Staff"
                        Icon="People"
                        Tag="StaffPage"
                        Visibility="{Binding StaffNavVisibility, Mode=OneWay}" />
                    <NavigationViewItem
                        x:Name="IamNavItem"
                        Content="IAM"
                        Tag="IAMPage"
                        Visibility="{Binding IamNavVisibility, Mode=OneWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                Glyph="&#xEC19;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="DeliveriesNavItem"
                        Content="Deliveries"
                        Tag="DeliveriesPage"
                        Visibility="{Binding DeliveriesNavVisibility, Mode=OneWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                Glyph="&#xE7B8;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="InventoryNavItem"
                        Content="Inventory"
                        Tag="InventoryPage"
                        Visibility="{Binding InventoryNavVisibility, Mode=OneWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                Glyph="&#xEC5A;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        Content="Distributions"
                        Icon="Reshare"
                        Tag="DistributionsPage"
                        Visibility="{Binding DistributionsNavVisibility, Mode=OneWay}" />
                    <NavigationViewItem
                        x:Name="TransfersNavItem"
                        Content="Transfers"
                        Icon="Sync"
                        Tag="TransfersPage"
                        Visibility="{Binding TransfersNavVisibility, Mode=OneWay}" />
                    <NavigationViewItem
                        Content="Stock Take"
                        Tag="StockTakePage"
                        Visibility="{Binding StockTakeNavVisibility, Mode=OneWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                FontFamily="Segoe Fluent Icons"
                                Glyph="&#xF0E4;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="MessageRequestsNavItem"
                        Content="Message Requests"
                        Tag="MessageRequestPage"
                        Visibility="{Binding MessageRequestsNavVisibility, Mode=OneWay}">   
                        <NavigationViewItem.Icon>
                            <FontIcon
                                Glyph="&#xE8BD;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="AnalyticsNavItem"
                        Content="Analytics and Reports"
                        Tag="AnalyticsPage"
                        Visibility="{Binding AnalyticsNavVisibility, Mode=OneWay}">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                Glyph="&#xE9F9;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>                    
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem
                        Content="Help"
                        Tag="Help">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                Glyph="&#xF6FA;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        Content="Settings"
                        Tag="Settings">
                        <NavigationViewItem.Icon>
                            <AnimatedIcon
                                x:Name='AnimatedIcon'>
                                <AnimatedIcon.Source>
                                    <animatedvisuals:AnimatedSettingsVisualSource />
                                </AnimatedIcon.Source>
                                <AnimatedIcon.FallbackIconSource>
                                    <FontIconSource
                                        Glyph="&#xE713;" />
                                </AnimatedIcon.FallbackIconSource>
                            </AnimatedIcon>
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        Content="Logout"
                        Tag="Logout">
                        <NavigationViewItem.Icon>
                            <FontIcon
                                Glyph="&#xF3B1;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Frame
                    x:Name="ContentFrame"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch" />

            </NavigationView>
        </Grid>
    </Grid>
</Page>