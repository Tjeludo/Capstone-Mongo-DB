<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App_v1.Pages.SupplierProductPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App_v1.Pages"
    xmlns:viewModels="using:App_v1.ViewModels"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    xmlns:notification="using:Syncfusion.UI.Xaml.Notifications"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:App_v1.Converters"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded">

    <Page.DataContext>
        <viewModels:SupplierProductViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Supplier Products Management"
                           FontSize="24"
                           VerticalAlignment="Center"
                           Grid.Column="0"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10"
                            Grid.Column="1">
                    <Button x:Name="DownloadButton"
                            Background="#1A98FF" 
                            Foreground="White"
                            CornerRadius="12"
                            Click="DownloadCSV_Click"
                            Visibility="{Binding CanDownloadCsv, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <StackPanel x:Name="DownloadContent" Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEBD3;"/>
                                <TextBlock Text="Download CSV"/>
                            </StackPanel>
                            <notification:SfBusyIndicator x:Name="DownloadBusyIndicator"
                                                          IsActive="False" 
                                                          AnimationType="DottedLinear"
                                                          SizeFactor="0.5" 
                                                          DurationFactor="0.5"
                                                          Visibility="Collapsed"
                                                          Height="20"
                                                          HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Button>
                    <Button x:Name="UploadButton"
                            Background="orange" 
                            Foreground="White"
                            CornerRadius="12"
                            Click="UploadCSV_Click"
                            Visibility="{Binding CanUploadCsv, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <StackPanel x:Name="UploadContent" Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE753;"/>
                                <TextBlock Text="Upload CSV"/>
                            </StackPanel>
                            <notification:SfBusyIndicator x:Name="UploadBusyIndicator"
                                                          IsActive="False" 
                                                          AnimationType="DottedLinear"
                                                          SizeFactor="0.5" 
                                                          DurationFactor="0.5"
                                                          Visibility="Collapsed"
                                                          Height="20"
                                                          HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <dataGrid:SfDataGrid x:Name="sfDataGrid"
                             Grid.Row="1"
                             ItemsSource="{Binding SupplierProducts}"
                             SelectionMode="None"
                             AllowFiltering="True"
                             AllowSorting="True"
                             AllowEditing="False"
                             GridLinesVisibility="Both"
                             HeaderLinesVisibility="Both"
                             ColumnWidthMode="Star"
                             AutoGenerateColumns="False">
            <dataGrid:SfDataGrid.Columns>
                <dataGrid:GridTextColumn MappingName="SupplierId" HeaderText="Supplier ID" />
                <dataGrid:GridTextColumn MappingName="ProductCode" HeaderText="Product Code"/>
                <dataGrid:GridTextColumn MappingName="Description" HeaderText="Description"/>
                <dataGrid:GridTextColumn MappingName="Price" HeaderText="Price (R)" TextAlignment="Right"/>
                <dataGrid:GridTextColumn MappingName="LastUpdated" HeaderText="Last Updated"/>

                <dataGrid:GridTemplateColumn HeaderText="Actions" Width="160" AllowFiltering="False" AllowSorting="False">
                    <dataGrid:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <Button Content="Edit" Background="#28a745" Foreground="White" CornerRadius="12" HorizontalAlignment="Center" Padding="8,4" Click="EditProduct_Click" Tag="{Binding}" Visibility="{Binding DataContext.CanEditProduct, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Button Content="Delete" Background="#dc3545" Foreground="White" CornerRadius="12" HorizontalAlignment="Center" Padding="8,4" Click="DeleteProduct_Click" Tag="{Binding}" Visibility="{Binding DataContext.CanDeleteProduct, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </dataGrid:GridTemplateColumn.CellTemplate>
                </dataGrid:GridTemplateColumn>
            </dataGrid:SfDataGrid.Columns>

            <dataGrid:SfDataGrid.RecordContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Edit" Command="{Binding GridEditCommand}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanEditProduct, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE932;" Foreground="Green"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Delete" Command="{Binding GridDeleteCommand}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanDeleteProduct, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74D;" Foreground="Red"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </dataGrid:SfDataGrid.RecordContextFlyout>
        </dataGrid:SfDataGrid>

        <ContentDialog
            x:Name="EditProductDialog"
            Title="Edit Product Price"
            PrimaryButtonText="Update"
            SecondaryButtonText="Cancel"
            DefaultButton="Primary">
            <StackPanel Spacing="12">
                <TextBox x:Name="EditSupplierIdTextBox" 
                         Header="Supplier ID" 
                         Width="300" 
                         IsReadOnly="True"
                         Background="LightGray"/>
                <TextBox x:Name="EditProductCodeTextBox" 
                         Header="Product Code" 
                         Width="300" 
                         IsReadOnly="True"
                         Background="LightGray"/>
                <TextBox x:Name="EditDescriptionTextBox" 
                         Header="Description" 
                         Width="300"
                         IsReadOnly="True"
                         Background="LightGray"/>
                <NumberBox x:Name="EditPriceNumberBox" 
                           Header="Price (R) *" 
                           Width="300"
                           Value="0"
                           Minimum="0"
                           SpinButtonPlacementMode="Compact"
                           SmallChange="0.01"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>