<Page
    x:Class="App_v1.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:App_v1.ViewModels"
    xmlns:scheduler="using:Syncfusion.UI.Xaml.Scheduler"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CircularButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource SystemControlForegroundBaseLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Spacing="16"
            Padding="24">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        Text="{x:Bind ViewModel.WelcomeMessage, Mode=OneWay}"
                        FontSize="28"
                        FontWeight="Normal"/>
                    <TextBlock
                        Text="Here is your snapshot for today."
                        Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                        Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button x:Name="AddProductButton"
                            Background="#41C200"
                            Foreground="White"
                            Click="AddProduct_Click"
                            CornerRadius="12"
                            Style="{StaticResource CircularButtonStyle}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon Glyph="&#xECC8;"/>
                            <TextBlock Text="Add Product"/>
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PlaceOrderButton"
                        Click="PlaceOrder_Click"
                        Background="#1A98FF" 
                        Foreground="White"
                        CornerRadius="12"
                        Style="{StaticResource CircularButtonStyle}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon Glyph="&#xE719;"/>
                            <TextBlock Text="Place Order"/>
                        </StackPanel>
                    </Button>
                    
                    <Button
                        x:Name="DistributeButton"
                        Background="Orange" 
                        Foreground="White"
                        Click="Distribute_Click"
                        CornerRadius="12"
                        Style="{StaticResource CircularButtonStyle}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <FontIcon Glyph="&#xE72D;"/>
                            <TextBlock Text="Distribute"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Enabled"
                VerticalScrollMode="Disabled"
                Margin="0,16,0,0"
                Padding="0,0,0,16">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.DashboardCards, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout
                            Orientation="Horizontal"
                            Spacing="16"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DashboardCard">
                            <Button
                                Click="DashboardCard_Click"
                                Tag="{x:Bind}"
                                BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Width="240"
                                Height="150"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <FontIcon
                                            Glyph="{x:Bind Icon}"
                                            FontSize="24"
                                            Foreground="{x:Bind ForegroundColor}"/>
                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock
                                        Text="{x:Bind Value}"
                                        HorizontalAlignment="Center"
                                        FontSize="40"
                                        FontWeight="Bold"/>
                                    <TextBlock
                                        Text="{x:Bind Description}"
                                        FontSize="12"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>

            <Grid
                Margin="0,16,0,0"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,0,0,8">
                        <FontIcon
                            Glyph="&#xEA8F;"
                            FontSize="20"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            Text="Recent Activity"
                            FontSize="20"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                    <ListView
                        ItemsSource="{x:Bind ViewModel.RecentActivity, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ActivityItem">
                                <Grid Padding="8,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Glyph="{x:Bind Icon}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,16,0"
                                        FontSize="20"
                                        Foreground="{x:Bind IconColor}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            Text="{x:Bind Title}"
                                            FontWeight="SemiBold"/>
                                        <TextBlock
                                            Text="{x:Bind Description}"
                                            Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"
                                            FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,0,0,8">
                        <FontIcon
                            Glyph="&#xE787;"
                            FontSize="20"
                            VerticalAlignment="Center"/>
                        <TextBlock
                            Text="Upcoming Deliveries"
                            FontSize="20"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                    <scheduler:SfScheduler
                        x:Name="Schedule"
                        ViewType="Month"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>