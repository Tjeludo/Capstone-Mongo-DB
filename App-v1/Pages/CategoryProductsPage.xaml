<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App_v1.Pages.CategoryProductsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App_v1.Pages"
    xmlns:models="using:App_v1.Models"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    xmlns:notification="using:Syncfusion.UI.Xaml.Notifications"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PageTitle"
                           Grid.Column="0"
                           Text="Category Products"
                           FontSize="24"
                           VerticalAlignment="Center"/>

                <Button x:Name="DownloadButton"
                        Grid.Column="1"
                        Background="#1A98FF" 
                        Foreground="White"
                        CornerRadius="12"
                        Click="DownloadCSV_Click">
                    <Grid>
                        <StackPanel x:Name="DownloadContent" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEBD3;" />
                            <TextBlock Text="Download CSV"/>
                        </StackPanel>
                        <notification:SfBusyIndicator x:Name="DownloadBusyIndicator"
                                                    IsActive="False" 
                                                    AnimationType="DottedLinear"
                                                    SizeFactor="0.5" 
                                                    DurationFactor="0.5"
                                                    Visibility="Collapsed"
                                                    Height="20"
                                                    HorizontalAlignment="Stretch"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="8" Margin="16,0">
            <InfoBar x:Name="SuccessInfoBar"
                     Severity="Success"
                     IsOpen="False"
                     IsClosable="True" />
            <InfoBar x:Name="ErrorInfoBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="True" />
        </StackPanel>

        <dataGrid:SfDataGrid x:Name="sfDataGrid"
                             Grid.Row="2"
                             ItemsSource="{Binding CategoryProducts}"
                             SelectionMode="None"
                             AllowFiltering="True"
                             AllowSorting="True"
                             AllowTriStateSorting="True"
                             AllowGrouping="True"
                             AllowEditing="False"
                             AllowResizingColumns="True"
                             GridLinesVisibility="Both"
                             HeaderLinesVisibility="Both"
                             ShowGroupDropArea="False"
                             ColumnWidthMode="Star"
                             NavigationMode="Row"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             AutoGenerateColumns="False">
            <dataGrid:SfDataGrid.Columns>
                <dataGrid:GridTextColumn MappingName="Id" HeaderText="Product Code" />
                <dataGrid:GridTextColumn MappingName="Name" HeaderText="Product Name"/>
                <dataGrid:GridTextColumn MappingName="Category" HeaderText="Category Code"/>
                <dataGrid:GridTextColumn MappingName="Price" HeaderText="Price (ZAR)"/>
                <dataGrid:GridTextColumn MappingName="Size" HeaderText="Size"/>
                <dataGrid:GridTextColumn MappingName="Colour" HeaderText="Colour"/>
            </dataGrid:SfDataGrid.Columns>
        </dataGrid:SfDataGrid>

    </Grid>
</Page>