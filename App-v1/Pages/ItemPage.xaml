<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App_v1.Pages.ItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:App_v1.ViewModels"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    xmlns:notification="using:Syncfusion.UI.Xaml.Notifications"
    xmlns:converters="using:App_v1.Converters"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded">

    <Page.DataContext>
        <viewModels:ItemViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Items" FontSize="24" VerticalAlignment="Center" Grid.Column="0"/>

                <notification:BadgeContainer x:Name="CartBadge" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <notification:BadgeContainer.Content>
                        <Button Click="CartButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Glyph="&#xE7BF;" Margin="0,0,4,0"/>
                                <TextBlock Text="Cart"/>
                            </StackPanel>
                        </Button>
                    </notification:BadgeContainer.Content>
                    <notification:BadgeContainer.Badge>
                        <notification:SfBadge x:Name="CartBadgeCount" 
                                              Shape="Oval" 
                                              Content="0" 
                                              Fill="Success"
                                              AnimationType="None"/>
                    </notification:BadgeContainer.Badge>
                </notification:BadgeContainer>
            </Grid>
        </Border>

        <dataGrid:SfDataGrid x:Name="sfDataGrid"
                             Grid.Row="1"
                             ItemsSource="{Binding Items}"
                             SelectionMode="None"
                             AllowFiltering="True"
                             AllowSorting="True"
                             GridLinesVisibility="Both"
                             HeaderLinesVisibility="Both"
                             ColumnWidthMode="Star"
                             AutoGenerateColumns="False">
            <dataGrid:SfDataGrid.Columns>
                <dataGrid:GridTextColumn MappingName="SupplierId" HeaderText="Supplier ID" />
                <dataGrid:GridTextColumn MappingName="ProductCode" HeaderText="Product Code" />
                <dataGrid:GridTextColumn MappingName="Description" HeaderText="Description" Width="300"/>
                <dataGrid:GridTextColumn MappingName="Price" HeaderText="Price (ZAR)" TextAlignment="Right"/>
                <dataGrid:GridTextColumn MappingName="LastUpdated" HeaderText="Last Updated"/>

                <dataGrid:GridTemplateColumn HeaderText="Actions" Width="180" AllowFiltering="False" AllowSorting="False">
                    <dataGrid:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                <Button Background="#007bff"
                                        Foreground="White"
                                        CornerRadius="12"
                                        HorizontalAlignment="Center"
                                        Padding="8,4"
                                        Click="AddToCart_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding DataContext.CanAddToCart, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;"/>
                                        <TextBlock Text="Add to Cart"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </dataGrid:GridTemplateColumn.CellTemplate>
                </dataGrid:GridTemplateColumn>
            </dataGrid:SfDataGrid.Columns>

            <dataGrid:SfDataGrid.RecordContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Add to Cart"
                                    Command="{Binding AddToCartCommand}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding DataContext.CanAddToCart, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE710;" Foreground="DodgerBlue"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </dataGrid:SfDataGrid.RecordContextFlyout>

        </dataGrid:SfDataGrid>
        <muxc:InfoBar x:Name="NotificationInfoBar"
                      IsOpen="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,0,0,24"
                      MaxWidth="800"/>
    </Grid>
</Page>