<Page
    x:Class="App_v1.Pages.CartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App_v1.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls" 
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock 
            Text="Cart" FontSize="24" FontWeight="Bold" Margin="16"/>

        <dataGrid:SfDataGrid x:Name="CartGrid"
                             Grid.Row="1"
                             ItemsSource="{x:Bind Cart, Mode=OneWay}"
                             AutoGenerateColumns="False"
                             ColumnWidthMode="Star">
            <dataGrid:SfDataGrid.Columns>
                <dataGrid:GridTextColumn MappingName="SupplierId" HeaderText="Supplier ID"/>
                <dataGrid:GridTextColumn MappingName="ProductCode" HeaderText="Product Code"/>
                <dataGrid:GridTextColumn MappingName="Description" HeaderText="Description"/>
                <dataGrid:GridTextColumn MappingName="Price" HeaderText="Price"/>
                <dataGrid:GridTextColumn MappingName="Quantity" HeaderText="Quantity"/>
                <dataGrid:GridTextColumn MappingName="Subtotal" HeaderText="Subtotal"/>
                <dataGrid:GridTemplateColumn HeaderText="Actions">
                    <dataGrid:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Button Content="+" Click="Increase_Click" Tag="{Binding ProductCode}"/>
                                <Button Content="-" Click="Decrease_Click" Tag="{Binding ProductCode}"/>
                            </StackPanel>
                        </DataTemplate>
                    </dataGrid:GridTemplateColumn.CellTemplate>
                </dataGrid:GridTemplateColumn>
            </dataGrid:SfDataGrid.Columns>
        </dataGrid:SfDataGrid>

        <Grid Grid.Row="2" Padding="16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TotalTextBlock" 
                       Grid.Column="0"
                       FontSize="18" 
                       FontWeight="Bold"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="ClearCartButton" Click="ClearCart_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;"/>
                        <TextBlock Text="Clear Cart"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ConfirmOrderButton" 
                        Background="#41C200" 
                        Foreground="White"
                        Click="ConfirmOrder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE930;"/>
                        <TextBlock Text="Confirm order"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <muxc:InfoBar x:Name="NotificationInfoBar"
                      IsOpen="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Margin="0,0,0,24"
                      MaxWidth="800"
                      Grid.Row="1"/>
    </Grid>
</Page>