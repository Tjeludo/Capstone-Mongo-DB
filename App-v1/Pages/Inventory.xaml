<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App_v1.Pages.Inventory"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:App_v1.Pages"
    xmlns:Models="using:App_v1.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    mc:Ignorable="d">
    <Page.DataContext>
        <Models:InventoryViewModel/>
    </Page.DataContext>

    <Grid x:Name="rootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Padding="16,12" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Inventory"
                           FontSize="24"
                           VerticalAlignment="Center"
                           Grid.Column="0"/>
                </Grid>
            </Border>
        </Grid>

        <dataGrid:SfDataGrid x:Name="InventoryDataGrid"
                           Grid.Row="1"
                           AutoGenerateColumns="True"
                           AutoGeneratingColumn="InventoryDataGrid_AutoGeneratingColumn"
                           ColumnWidthMode="Star"
                           ItemsSource="{Binding Inventories}"
                           Width="Auto"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           AllowDraggingColumns="True"
                           AllowSorting="True"
                           AllowEditing="False"
                           SelectionMode="Multiple"
                           AllowFiltering="True"
                           AllowGrouping="True"
                           GridLinesVisibility="Both"
                           HeaderLinesVisibility="Both"
                           ShowGroupDropArea="False" />
    </Grid>
</Page>