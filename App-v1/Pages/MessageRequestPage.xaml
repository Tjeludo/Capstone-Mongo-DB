<Page
    x:Class="App_v1.Pages.MessageRequestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:App_v1.ViewModels"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    xmlns:converters="using:App_v1.Converters"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:MessageRequestViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Message Requests" FontSize="24" VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Background="#41C200"
                        Foreground="White"
                        Click="CreateRequest_Click"
                        Visibility="{Binding IsManager, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE724;" />
                        <TextBlock Text="Create New Request" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <dataGrid:SfDataGrid x:Name="RequestsGrid"
                             Grid.Row="1"
                             ItemsSource="{Binding Requests}"
                             AutoGenerateColumns="False"
                             SelectionMode="None"
                             ColumnWidthMode="Star">
            <dataGrid:SfDataGrid.Columns>
                <dataGrid:GridTextColumn MappingName="Id" HeaderText="Request ID"/>
                <dataGrid:GridTextColumn MappingName="Title" HeaderText="Title"/>
                <dataGrid:GridTextColumn MappingName="Body" HeaderText="Message"/>
                <dataGrid:GridTextColumn MappingName="RequesterId" HeaderText="Requester"/>
                <dataGrid:GridTextColumn MappingName="Status" HeaderText="Status"/>
                <dataGrid:GridTextColumn MappingName="CreatedAt" HeaderText="Date"/>

                <dataGrid:GridTemplateColumn HeaderText="Actions" Width="200"
                                             AllowFiltering="False" AllowSorting="False"
                                             IsHidden="{Binding DataContext.IsManager, ElementName=RequestsGrid}">
                    <dataGrid:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center"
                                        Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button Background="#28a745" Foreground="White" CornerRadius="12" Padding="8,4" Click="Approve_Click" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE73E;"/>
                                        <TextBlock Text="Approve" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Background="#dc3545" Foreground="White" CornerRadius="12" Padding="8,4" Click="Decline_Click" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xECE4;"/>
                                        <TextBlock Text="Decline" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </dataGrid:GridTemplateColumn.CellTemplate>
                </dataGrid:GridTemplateColumn>
            </dataGrid:SfDataGrid.Columns>
        </dataGrid:SfDataGrid>

        <InfoBar x:Name="NotificationInfoBar" Grid.Row="1" IsOpen="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24"/>
    </Grid>
</Page>