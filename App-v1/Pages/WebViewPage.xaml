<Page
    x:Class="App_v1.Pages.WebViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:App_v1.ViewModels"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:WebViewViewModel/>
    </Page.DataContext>

    <Grid x:Name="ContentArea">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <WebView2
            x:Name="WebView"
            Source="{x:Bind ViewModel.Source, Mode=OneWay}" />

        <!-- Loading Indicator -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock Text="Loading..." HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Error Message -->
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.HasFailures, Mode=OneWay}">
            <TextBlock Text="Page failed to load." HorizontalAlignment="Center" TextWrapping="WrapWholeWords" />
            <HyperlinkButton Content="Reload" Command="{x:Bind ViewModel.ReloadCommand}" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Browser Controls -->
        <Grid Grid.Row="1" Padding="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel Orientation="Horizontal">
                <Button Command="{x:Bind ViewModel.BrowserBackCommand}" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" />
                </Button>
                <Button Command="{x:Bind ViewModel.BrowserForwardCommand}" Margin="12,0,0,0" ToolTipService.ToolTip="Forward">
                    <FontIcon Glyph="&#xE72A;" />
                </Button>
            </StackPanel >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{x:Bind ViewModel.ReloadCommand}" ToolTipService.ToolTip="Reload">
                    <FontIcon Glyph="&#xE72C;" />
                </Button>
                <Button Command="{x:Bind ViewModel.OpenInBrowserCommand}" Margin="12,0,0,0" ToolTipService.ToolTip="Open in browser">
                    <FontIcon Glyph="&#xE774;" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
