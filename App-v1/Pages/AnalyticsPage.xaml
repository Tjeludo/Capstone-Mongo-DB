<Page
    x:Class="App_v1.Pages.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:App_v1.ViewModels"
    xmlns:chart="using:Syncfusion.UI.Xaml.Charts"
    mc:Ignorable="d">

    <Page.DataContext>
        <viewModels:AnalyticsViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <Style x:Key="axisStyle" TargetType="Line">
            <Setter Property="Stroke" Value="Transparent"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Padding="24">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Analytics Dashboard" 
                           FontSize="28" 
                           FontWeight="Normal"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Column="1"
                          ItemsSource="{x:Bind ViewModel.Periods, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedPeriod, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          Width="200"
                          VerticalAlignment="Center"
                          PlaceholderText="Select Time Period"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16" MinHeight="350" Margin="0,0,8,16">
                    <chart:SfCircularChart Header="Order Status Distribution">
                        <chart:SfCircularChart.Legend>
                            <chart:ChartLegend IconWidth="15" IconHeight="15"/>
                        </chart:SfCircularChart.Legend>

                        <chart:DoughnutSeries ItemsSource="{x:Bind ViewModel.OrderStatusDistribution, Mode=OneWay}" 
                                              XBindingPath="Status" 
                                              YBindingPath="Count"
                                              ShowDataLabels="True"
                                              ExplodeOnTap="True"
                                              ExplodeRadius="10"
                                              ExplodeIndex="1"
                                              LegendIcon="Circle"
                                              Radius="0.8">
                            <chart:DoughnutSeries.PaletteBrushes>
                                <SolidColorBrush Color="#007BFF"/>
                                <SolidColorBrush Color="#28A745"/>
                                <SolidColorBrush Color="#FD7E14"/>
                                <SolidColorBrush Color="#E83E8C"/>
                                <SolidColorBrush Color="#FFC107"/>
                                <SolidColorBrush Color="#17A2B8"/>
                            </chart:DoughnutSeries.PaletteBrushes>
                            <chart:DoughnutSeries.DataLabelSettings>
                                <chart:CircularDataLabelSettings Position="Inside" ShowConnectorLine="True"/>
                            </chart:DoughnutSeries.DataLabelSettings>
                        </chart:DoughnutSeries>
                    </chart:SfCircularChart>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16" MinHeight="350" Margin="8,0,0,16">
                    <chart:SfCircularChart Header="Order Count by Supplier">
                        <chart:SfCircularChart.Legend>
                            <chart:ChartLegend IconWidth="15" IconHeight="15"/>
                        </chart:SfCircularChart.Legend>

                        <chart:PieSeries ItemsSource="{x:Bind ViewModel.OrderFrequencyBySupplier, Mode=OneWay}" 
                                         XBindingPath="SupplierId" 
                                         YBindingPath="OrderCount"
                                         ShowDataLabels="True"
                                         EnableAnimation="True"
                                         LegendIcon="Circle">
                            <chart:PieSeries.DataLabelSettings>
                                <chart:CircularDataLabelSettings Position="OutsideExtended" ShowConnectorLine="True"/>
                            </chart:PieSeries.DataLabelSettings>
                        </chart:PieSeries>
                    </chart:SfCircularChart>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="8" Padding="16" MinHeight="350" Margin="0">
                    <chart:SfCartesianChart Header="Top 5 Ordered Products">
                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis ShowMajorGridLines="False"/>
                        </chart:SfCartesianChart.XAxes>
                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis Header="Quantity Ordered" Minimum="0"/>
                        </chart:SfCartesianChart.YAxes>

                        <chart:ColumnSeries ItemsSource="{x:Bind ViewModel.MostOrderedProducts, Mode=OneWay}" 
                                            XBindingPath="ProductCode" 
                                            YBindingPath="TotalQuantity"
                                            EnableAnimation="True"
                                            ShowDataLabels="True"
                                            EnableTooltip="True"
                                            SegmentSpacing="0.5"
                                            Fill="#007BFF">
                            <chart:ColumnSeries.DataLabelSettings>
                                <chart:CartesianDataLabelSettings Position="Inner"/>
                            </chart:ColumnSeries.DataLabelSettings>
                        </chart:ColumnSeries>
                    </chart:SfCartesianChart>
                </Border>

                <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                              Grid.ColumnSpan="2" 
                              Grid.RowSpan="2"
                              Width="100" 
                              Height="100"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>