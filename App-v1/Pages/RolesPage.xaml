<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App_v1.Pages.RolesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:App_v1.ViewModels"
    xmlns:notification="using:Syncfusion.UI.Xaml.Notifications"
    xmlns:converters="using:App_v1.Converters"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded">

    <Page.DataContext>
        <viewModels:RolesViewModel />
    </Page.DataContext>

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- (Header section is unchanged) -->
        <Border Grid.Row="0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="24" Text="Roles Management" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="AddRoleButton" Background="#41C200" CornerRadius="12" Click="AddRole_Click" Foreground="White" Visibility="{Binding CanAddRole, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xECC8;"/>
                            <TextBlock Text="Add Role" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownloadButton" Background="#1A98FF" CornerRadius="12" Click="DownloadCSV_Click" Foreground="White" Visibility="{Binding CanDownloadCsv, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <StackPanel x:Name="DownloadContent" Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEBD3;" />
                                <TextBlock Text="Download CSV" />
                            </StackPanel>
                            <notification:SfBusyIndicator x:Name="DownloadBusyIndicator" Height="20" HorizontalAlignment="Stretch" AnimationType="DottedLinear" DurationFactor="0.5" IsActive="False" SizeFactor="0.5" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button x:Name="UploadButton" Background="#FD7E14" CornerRadius="12" Click="UploadCSV_Click" Foreground="White" Visibility="{Binding CanUploadCsv, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <StackPanel x:Name="UploadContent" Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE753;"/>
                                <TextBlock Text="Upload CSV" />
                            </StackPanel>
                            <notification:SfBusyIndicator x:Name="UploadBusyIndicator" Height="20" HorizontalAlignment="Stretch" AnimationType="DottedLinear" DurationFactor="0.5" IsActive="False" SizeFactor="0.5" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <dataGrid:SfDataGrid
            x:Name="sfDataGrid"
            Grid.Row="1"
            ItemsSource="{Binding Roles}"
            AllowEditing="False"
            AllowFiltering="True"
            AllowSorting="True"
            AllowTriStateSorting="True"
            AutoGenerateColumns="False"
            ColumnWidthMode="Star"
            GridLinesVisibility="Both"
            HeaderLinesVisibility="Both"
            SelectionMode="None">
            <dataGrid:SfDataGrid.Columns>
                <dataGrid:GridTextColumn HeaderText="Role Code" MappingName="RoleCode" />
                <dataGrid:GridTextColumn HeaderText="Role Name" MappingName="RoleName" />
                <dataGrid:GridTextColumn HeaderText="Abbreviation" MappingName="RoleAbbreviation" />
                <dataGrid:GridTextColumn HeaderText="Status" MappingName="Status" />

                <!-- (Actions column is unchanged) -->
                <dataGrid:GridTemplateColumn Width="240" AllowFiltering="False" AllowSorting="False" HeaderText="Actions">
                    <dataGrid:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="5">
                                <Button Padding="8,4" HorizontalAlignment="Center" Background="#17a2b8" CornerRadius="12" Click="ViewRole_Click" Foreground="White" Tag="{Binding}" Visibility="{Binding DataContext.CanViewRole, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE890;"/>
                                        <TextBlock VerticalAlignment="Center" Text="View"/>
                                    </StackPanel>
                                </Button>
                                <Button Padding="8,4" HorizontalAlignment="Center" Background="#28a745" CornerRadius="12" Click="EditRole_Click" Foreground="White" Tag="{Binding}" Visibility="{Binding DataContext.CanEditRole, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE932;"/>
                                        <TextBlock VerticalAlignment="Center" Text="Edit" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="8,4" HorizontalAlignment="Center" Background="#dc3545" CornerRadius="12" Click="DeleteRole_Click" Foreground="White" Tag="{Binding}" Visibility="{Binding DataContext.CanDeleteRole, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE74D;"/>
                                        <TextBlock VerticalAlignment="Center" Text="Delete" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </dataGrid:GridTemplateColumn.CellTemplate>
                </dataGrid:GridTemplateColumn>
            </dataGrid:SfDataGrid.Columns>

            <!-- (RecordContextFlyout is unchanged) -->
            <dataGrid:SfDataGrid.RecordContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="View Permissions" Command="{Binding GridViewCommand}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanViewRole, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8A7;" Foreground="RoyalBlue"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Edit" Command="{Binding GridEditCommand}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanEditRole, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE932;" Foreground="Green"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Delete" Command="{Binding GridDeleteCommand}" CommandParameter="{Binding}" Visibility="{Binding DataContext.CanDeleteRole, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74D;" Foreground="Red"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </dataGrid:SfDataGrid.RecordContextFlyout>

        </dataGrid:SfDataGrid>

        <!-- Add Role Dialog -->
        <ContentDialog x:Name="AddRoleDialog" Title="Add Role" DefaultButton="Primary" IsPrimaryButtonEnabled="True" PrimaryButtonText="Save" SecondaryButtonText="Cancel">
            <ScrollViewer Padding="0,0,12,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBox x:Name="RoleNameTextBox" Width="300" Header="Role Name *" PlaceholderText="Enter role name" />
                    <TextBox x:Name="RoleAbrvTextBox" Width="300" Header="Abbreviation *" PlaceholderText="Enter role abbreviation (e.g., ADM, MGR)" />
                    <!-- REMOVED: Description TextBox is no longer here -->
                    <ComboBox x:Name="RoleStatusComboBox" Width="300" Header="Status *" SelectedIndex="0">
                        <ComboBoxItem Content="Active" />
                        <ComboBoxItem Content="Inactive" />
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- Edit Role Dialog -->
        <ContentDialog x:Name="EditRoleDialog" Title="Edit Role" DefaultButton="Primary" IsPrimaryButtonEnabled="True" PrimaryButtonText="Update" SecondaryButtonText="Cancel">
            <ScrollViewer Padding="0,0,12,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBox x:Name="EditRoleCodeTextBox" Width="300" Background="LightGray" Header="Role Code" IsReadOnly="True" />
                    <TextBox x:Name="EditRoleNameTextBox" Width="300" Header="Role Name *" PlaceholderText="Enter role name" />
                    <TextBox x:Name="EditRoleAbrvTextBox" Width="300" Header="Abbreviation *" PlaceholderText="Enter role abbreviation (e.g., ADM, MGR)" />
                    <!-- REMOVED: Description TextBox is no longer here -->
                    <ComboBox x:Name="EditRoleStatusComboBox" Width="300" Header="Status *" SelectedIndex="0">
                        <ComboBoxItem Content="Active" />
                        <ComboBoxItem Content="Inactive" />
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>