<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="App_v1.Pages.OrdersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:App_v1.ViewModels"
    xmlns:dataGrid="using:Syncfusion.UI.Xaml.DataGrid"
    xmlns:notification="using:Syncfusion.UI.Xaml.Notifications"
    xmlns:converters="using:App_v1.Converters"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Unloaded="Page_Unloaded">

    <Page.DataContext>
        <viewModels:OrdersViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header with title + action buttons -->
        <Border Grid.Row="0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Orders Management"
                           FontSize="24"
                           VerticalAlignment="Center"
                           Grid.Column="0"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10"
                            Grid.Column="1">

                    <!-- Place Order -->
                    <Button x:Name="PlaceOrderButton"
                            Background="#41C200"
                            Foreground="White"
                            CornerRadius="12"
                            Click="PlaceOrder_Click"
                            Visibility="{Binding CanPlaceOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xECC8;"/>
                            <TextBlock Text="Place Order"/>
                        </StackPanel>
                    </Button>

                    <!-- Download CSV -->
                    <Button x:Name="DownloadButton"
                            Background="#1A98FF"
                            Foreground="White"
                            CornerRadius="12"
                            Click="DownloadCSV_Click"
                            Visibility="{Binding CanDownloadCsv, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <StackPanel x:Name="DownloadContent"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <FontIcon Glyph="&#xEBD3;"/>
                                <TextBlock Text="Download CSV"/>
                            </StackPanel>
                            <notification:SfBusyIndicator x:Name="DownloadBusyIndicator"
                                                          IsActive="False"
                                                          AnimationType="DottedLinear"
                                                          SizeFactor="0.5"
                                                          DurationFactor="0.5"
                                                          Visibility="Collapsed"
                                                          Height="20"
                                                          HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Orders table -->
        <dataGrid:SfDataGrid x:Name="sfDataGrid"
                             Grid.Row="1"
                             ItemsSource="{Binding Orders}"
                             SelectionMode="None"
                             AllowFiltering="True"
                             AllowSorting="True"
                             AllowTriStateSorting="True"
                             AllowEditing="False"
                             GridLinesVisibility="Both"
                             HeaderLinesVisibility="Both"
                             ColumnWidthMode="Star"
                             AutoGenerateColumns="False">

            <dataGrid:SfDataGrid.Columns>
                <dataGrid:GridTextColumn MappingName="Id" HeaderText="Order ID"/>
                <dataGrid:GridTextColumn MappingName="SupplierId" HeaderText="Supplier ID"/>
                <dataGrid:GridTextColumn MappingName="TotalCost" HeaderText="Total Cost (R)" TextAlignment="Right"/>
                <dataGrid:GridTextColumn MappingName="Status" HeaderText="Status"/>
                <dataGrid:GridTextColumn MappingName="OrderDate" HeaderText="Order Date"/>
                <dataGrid:GridTextColumn MappingName="ExpectDelivery" HeaderText="Expected Delivery"/>
                <dataGrid:GridTextColumn MappingName="OrderedBy" HeaderText="Ordered By"/>

                <!-- Actions column -->
                <dataGrid:GridTemplateColumn HeaderText="Actions" Width="260" AllowFiltering="False" AllowSorting="False">
                    <dataGrid:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">

                                <!-- View -->
                                <Button Background="#17a2b8"
                                        Foreground="White"
                                        CornerRadius="12"
                                        HorizontalAlignment="Center"
                                        Padding="8,4"
                                        Click="ViewOrder_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding DataContext.CanViewOrder, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE890;"/>
                                        <TextBlock Text="View" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Edit -->
                                <Button Background="#28a745"
                                        Foreground="White"
                                        CornerRadius="12"
                                        HorizontalAlignment="Center"
                                        Padding="8,4"
                                        Click="EditOrder_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding DataContext.CanEditOrder, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE932;"/>
                                        <TextBlock Text="Status" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Cancel -->
                                <Button Background="#dc3545"
                                        Foreground="White"
                                        CornerRadius="12"
                                        HorizontalAlignment="Center"
                                        Padding="8,4"
                                        Click="CancelOrder_Click"
                                        Tag="{Binding}"
                                        Visibility="{Binding DataContext.CanCancelOrder, ElementName=sfDataGrid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE711;"/>
                                        <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </dataGrid:GridTemplateColumn.CellTemplate>
                </dataGrid:GridTemplateColumn>
            </dataGrid:SfDataGrid.Columns>
        </dataGrid:SfDataGrid>

        <!-- Page-level notification bar -->
        <muxc:InfoBar x:Name="NotificationInfoBar"
                      IsOpen="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,24"
                      MaxWidth="800"/>

        <!-- Edit order dialog -->
        <ContentDialog x:Name="EditOrderDialog"
                       Title="Edit Order Status"
                       PrimaryButtonText="Update Status"
                       SecondaryButtonText="Cancel"
                       DefaultButton="Primary"
                       IsPrimaryButtonEnabled="False"
                       PrimaryButtonClick="EditOrderDialog_PrimaryButtonClick">

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="1" Spacing="12">
                    <TextBox x:Name="EditOrderIdTextBox"
                             Header="Order ID"
                             Width="300"
                             IsReadOnly="True"
                             Background="LightGray"/>
                    <ComboBox x:Name="EditOrderStatusComboBox"
                              Header="Status *"
                              Width="300"
                              PlaceholderText="Select a status"
                              SelectionChanged="EditForm_InputChanged">
                        <ComboBoxItem Content="Confirmed"/>
                        <ComboBoxItem Content="In-Progress"/>
                        <ComboBoxItem Content="In-Transit"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </ContentDialog>
    </Grid>
</Page>
